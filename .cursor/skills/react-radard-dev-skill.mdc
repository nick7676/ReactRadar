## Key Knowledge: Playwright for CLI Testing

Playwright in this project is used to **spawn the CLI as a child process** and assert:
- stdout / stderr content
- output JSON file content
- process exit codes

### Setup pattern (`playwright.config.ts`)
```typescript
import { defineConfig } from '@playwright/test';

export default defineConfig({
  testDir: './tests',
  timeout: 30000,
  use: {
    // No browser needed — CLI-only testing
  },
});
```

### Test helper: spawn CLI

Always use a shared helper to spawn the CLI, never inline `execSync` in tests:
```typescript
// tests/helpers/cli.ts
import { execSync, spawnSync } from 'child_process';
import path from 'path';

const CLI_PATH = path.resolve(__dirname, '../../dist/index.js');

export function runCLI(args: string[]): {
  stdout: string;
  stderr: string;
  exitCode: number;
} {
  const result = spawnSync('node', [CLI_PATH, ...args], {
    encoding: 'utf-8',
  });

  return {
    stdout: result.stdout ?? '',
    stderr: result.stderr ?? '',
    exitCode: result.status ?? 1,
  };
}
```

### Test pattern: stdout and exit code
```typescript
// tests/scan.spec.ts
import { test, expect } from '@playwright/test';
import { runCLI } from './helpers/cli';
import path from 'path';

const FIXTURE_PATH = path.resolve(__dirname, '../fixtures/sample-react-app');

test('scan command exits with 0 on valid project', () => {
  const { exitCode } = runCLI(['scan', FIXTURE_PATH]);
  expect(exitCode).toBe(0);
});

test('scan command outputs valid JSON', () => {
  const { stdout } = runCLI(['scan', FIXTURE_PATH, '--format', 'text']);
  expect(stdout).toContain('ReactRadar');
});

test('scan command fails with exit code 1 on missing path', () => {
  const { exitCode, stderr } = runCLI(['scan', './nonexistent']);
  expect(exitCode).toBe(1);
  expect(stderr).toMatch(/not found|invalid/i);
});
```

### Test pattern: JSON output file
```typescript
import fs from 'fs';
import path from 'path';

test('scan command writes radar.json', () => {
  const outputPath = path.resolve(__dirname, '../radar.json');

  // Clean up before test
  if (fs.existsSync(outputPath)) fs.unlinkSync(outputPath);

  const { exitCode } = runCLI(['scan', FIXTURE_PATH, '--output', outputPath]);

  expect(exitCode).toBe(0);
  expect(fs.existsSync(outputPath)).toBe(true);

  const json = JSON.parse(fs.readFileSync(outputPath, 'utf-8'));
  expect(json).toHaveProperty('components');
});
```

