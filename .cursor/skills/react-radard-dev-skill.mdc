## Key Knowledge: Yargs (TypeScript ESM)

Standard command pattern used in this project:
```typescript
import type { CommandModule } from "yargs";
import { someHandler } from "../handlers/some.handler.js";
import type { SharedArgv } from "./sharedOptions.js";
import { sharedOptions } from "./sharedOptions.js";

export const someCommand: CommandModule<{}, SharedArgv> = {
  command: "mycmd",
  describe: "Does something",
  builder: (yargs) => sharedOptions(yargs),
  handler: (argv) => someHandler(argv),
};
```

Shared options provide `--path` and `--format` to all commands:
```typescript
export const sharedOptions = <T>(yargs: Argv<T>): Argv<T & SharedArgv> =>
  yargs
    .option("format", { alias: "f", type: "string", choices: ["table", "json"], default: "table" })
    .option("path", { alias: "p", type: "string" });
```

