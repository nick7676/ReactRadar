## Key Knowledge: Playwright for CLI Testing

Playwright is used to **spawn the CLI as a child process** (no browser), asserting:
- stdout / stderr content
- process exit codes
- JSON output validity

### Config (`playwright.config.ts`)
```typescript
import { defineConfig } from "@playwright/test";

export default defineConfig({
  testDir: "./tests",
  timeout: 30_000,
  globalSetup: "./tests/global-setup.ts",  // runs tsc build
  fullyParallel: true,
  forbidOnly: !!process.env.CI,
  retries: process.env.CI ? 2 : 0,
  workers: process.env.CI ? 1 : undefined,
  reporter: "html",
  projects: [{ name: "cli" }],
});
```

### Test Helper (`tests/helpers/cli.ts`)
```typescript
import { spawnSync } from "node:child_process";
import path from "node:path";
import { fileURLToPath } from "node:url";

const repoRoot = path.join(path.dirname(fileURLToPath(import.meta.url)), "../..");
const CLI_PATH = path.join(repoRoot, "dist/index.js");

export function runCLI(args: string[]): { stdout: string; stderr: string; exitCode: number } {
  const env = { ...process.env };
  delete env.FORCE_COLOR;
  env.NO_COLOR = "1";
  const result = spawnSync(process.execPath, [CLI_PATH, ...args], {
    encoding: "utf8",
    cwd: repoRoot,
    env,
  });
  return {
    stdout: result.stdout ?? "",
    stderr: result.stderr ?? "",
    exitCode: result.status ?? 1,
  };
}
```

### Test Patterns

**Exit code + stdout assertions:**
```typescript
test("analyze exits 0 with components", () => {
  const { stdout, exitCode } = runCLI(["analyze", "--path", fixture]);
  expect(exitCode).toBe(0);
  expect(stdout).toContain("Button");
});
```

**JSON output parsing:**
```typescript
test("analyze --format json outputs parseable JSON", () => {
  const { stdout, exitCode } = runCLI(["analyze", "--path", fixture, "--format", "json"]);
  expect(exitCode).toBe(0);
  const data = JSON.parse(stdout.slice(stdout.indexOf("[")));
  expect(data.some((x: any) => x.componentName === "Button")).toBe(true);
});
```

**Error cases (exitCode 1 + stderr):**
```typescript
test("exits 1 for missing path", () => {
  const { exitCode, stderr } = runCLI(["analyze", "--path", "/nonexistent"]);
  expect(exitCode).toBe(1);
  expect(stderr).toMatch(/No directory found/);
});
```

